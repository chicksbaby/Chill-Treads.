# ==============================================================================
# CHILL TREADS E-COMMERCE CONFIGURATION (.env.example)
# Copy this file to .env for local testing or configure in Vercel Project Settings.
# ==============================================================================

# --- DATABASE CONFIGURATION ---
# For Vercel Production: Supply your hosted PostgreSQL connection string (Supabase, Neon, AWS RDS, Cloud SQL)
# Example Supabase pooled connection string:
# postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# Optional local SQLite file path override (Used automatically when DATABASE_URL is omitted)
DATABASE_PATH=

# --- STORE OPERATIONS & ENVIRONMENT MODES ---
# Keep DEMO_MODE=true until ready for real storefront traffic
DEMO_MODE=true

# Keep PAYMENT_GATEWAY_MODE=test to prevent live card/UPI transactions
PAYMENT_GATEWAY_MODE=test

# --- SECURITY & AUTHENTICATION SECRETS ---
# Cryptographic secret for signing order tracking tokens and session integrity
TOKEN_SIGNING_SECRET=

# Secret passphrase for the CHILL TREADS Admin Dashboard
ADMIN_SECRET_KEY=

# Webhook secret for validating HMAC-SHA256 signatures from Razorpay/Payment Gateway
PAYMENT_WEBHOOK_SECRET=

# --- PAYMENT GATEWAY CREDENTIALS (Razorpay Test Keys) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- DROPSHIPPING & SUPPLIER API CONFIGURATION ---
SUPPLIER_API_PROVIDER=
SUPPLIER_API_KEY=
SUPPLIER_API_ENDPOINT=

# --- SERVER RUNTIME ---
PORT=3000